# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary Configuration (optional)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key_here
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Admin Email
VITE_ADMIN_EMAIL=admin@khat.com

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Brevo server-side configuration
# Do not prefix these with VITE_ or expose the API key in browser code.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=admin@khat.com
BREVO_SENDER_NAME=Khat
ORDER_NOTIFICATION_EMAIL=admin@khat.com
